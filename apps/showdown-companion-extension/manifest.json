{
  "manifest_version": 3,
  "name": "PokeStrategist Showdown Companion",
  "version": "0.1.0",
  "description": "Injects a decision-assist panel into Pokemon Showdown and queries a local pokestrategist suggestion endpoint.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://play.pokemonshowdown.com/*",
    "https://*.psim.us/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "pokestrategist",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.pokemonshowdown.com/*",
        "https://*.psim.us/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}